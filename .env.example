NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_IDLE_MINUTES=30
SESSION_REMEMBER_DAYS=14

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hris_karyawan
DB_USER=hris_app
DB_PASSWORD=change-this-password
DB_CONNECTION_LIMIT=10
DB_SSL=0
DB_SSL_CA=
DB_MIGRATION_USER=hris_migrator
DB_MIGRATION_PASSWORD=change-this-migration-password

# WebAuthn: RP_ID must be the hostname without scheme or port.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=HRIS Karyawan
WEBAUTHN_ORIGIN=http://localhost:3000

# Set to 1 only when the app is behind a trusted HTTPS reverse proxy.
TRUST_PROXY=0
